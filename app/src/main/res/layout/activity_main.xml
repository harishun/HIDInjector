<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_slate"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:ignore="TooManyViews,Overdraw">

    <!-- Top Action Bar -->
    <RelativeLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:background="@color/bg_header"
        android:paddingHorizontal="16dp"
        android:paddingTop="24dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/header_right_actions"
            android:layout_marginEnd="8dp"
            android:layout_centerVertical="true" />

        <LinearLayout
            android:id="@+id/header_right_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/btn_theme"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/light_mode_24"
                android:layout_marginEnd="20dp"
                android:contentDescription="@string/toggle_theme" />

            <ImageView
                android:id="@+id/btn_refresh_bar"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_refresh"
                app:tint="#FFFFFF"
                android:contentDescription="@string/refresh_link" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Connection / Status Selector Header -->
    <LinearLayout
        android:id="@+id/connection_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_below="@id/action_bar"
        android:background="@color/bg_slate"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:weightSum="6"
        android:baselineAligned="false">

        <Spinner
            android:id="@+id/spinner_devices"
            android:layout_width="0dp"
            android:layout_weight="4"
            android:layout_height="50dp"
            android:background="@drawable/spinner_background"
            android:paddingHorizontal="12dp"
            android:spinnerMode="dropdown"
            android:overlapAnchor="false"
            android:dropDownVerticalOffset="4dp"
            android:dropDownHorizontalOffset="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:layout_marginStart="10dp"
            android:background="@drawable/edit_text_background"
            android:gravity="center">

            <View
                android:id="@+id/view_status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@color/status_red" />

            <TextView
                android:id="@+id/tv_status_on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_off"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content Frame -->
    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/connection_header"
        android:layout_above="@+id/bottom_navigation"
        android:padding="16dp">

        <!-- 1. Shortcuts Screen -->
        <RelativeLayout
            android:id="@+id/screen_shortcuts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_shortcuts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />
        </RelativeLayout>

        <!-- 2. Input Screen -->
        <LinearLayout
            android:id="@+id/screen_input"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Trackpad Area -->
            <FrameLayout
                android:id="@+id/trackpad_area"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/trackpad_background"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_gravity="center"
                    android:gravity="center"
                    tools:ignore="UseCompoundDrawables,UselessParent">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_trackpad"
                        app:tint="@color/text_primary"
                        android:layout_marginBottom="12dp"
                        android:contentDescription="@string/trackpad" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trackpad"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Mouse Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                tools:ignore="ButtonStyle">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_mouse_left"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="@string/btn_left"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_mouse_left"
                    android:drawableTint="#FFFFFF"
                    android:drawablePadding="6dp"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_primary"
                    app:backgroundTint="@null"
                    android:layout_marginEnd="8dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_mouse_middle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="@string/btn_middle"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_mouse_middle"
                    android:drawableTint="#FFFFFF"
                    android:drawablePadding="6dp"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_primary"
                    app:backgroundTint="@null"
                    android:layout_marginEnd="8dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_mouse_right"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="@string/btn_right"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_mouse_right"
                    android:drawableTint="#FFFFFF"
                    android:drawablePadding="6dp"
                    android:paddingHorizontal="12dp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_primary"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <!-- Real-time Keyboard input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/edit_text_background"
                android:paddingHorizontal="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_keyboard"
                    app:tint="@color/text_primary"
                    android:contentDescription="@string/keyboard" />

                <EditText
                    android:id="@+id/et_realtime_keyboard"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="@string/hint_realtime_keyboard"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:background="@null"
                    android:layout_marginStart="12dp"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Scripting Screen -->
        <RelativeLayout
            android:id="@+id/screen_scripting"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- Actions Row Top -->
            <LinearLayout
                android:id="@+id/script_top_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:id="@+id/btn_script_library"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:background="@drawable/button_primary"
                    android:layout_marginEnd="15dp"
                    android:src="@drawable/newsstand_24"
                    app:tint="#FFFFFF"
                    android:padding="12dp"
                    android:contentDescription="@string/desc_script_library"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/btn_script_save"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:background="@drawable/button_primary"
                    android:src="@drawable/save_24"
                    app:tint="@color/status_green"
                    android:padding="12dp"
                    android:contentDescription="@string/desc_save_script"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Editor -->
            <EditText
                android:id="@+id/et_ducky_script"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/script_top_actions"
                android:layout_above="@+id/btn_execute_script"
                android:layout_marginBottom="20dp"
                android:hint="@string/hint_ducky_script"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:gravity="top|start"
                android:background="@drawable/edit_text_background"
                android:padding="16dp"
                android:inputType="textMultiLine"
                android:importantForAutofill="no"
                android:scrollbars="vertical" />

            <!-- Execute Script Button with Play Icon -->
            <LinearLayout
                android:id="@+id/btn_execute_script"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_above="@+id/tv_script_status"
                android:background="@drawable/button_primary"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_play"
                    app:tint="#FFFFFF"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/desc_execute_script" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_execute_script"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_script_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:text="@string/status_ready"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </RelativeLayout>

        <!-- 4. Settings Screen -->
        <ScrollView
            android:id="@+id/screen_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbars="vertical"
            android:fadeScrollbars="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:clipToPadding="false">

                <!-- Profile & Target Group -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_and_target"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:letterSpacing="0.1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/target_os"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/target_os_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/spinner_settings_os"
                        android:layout_width="120dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/spinner_background"
                        android:paddingStart="8dp"
                        android:paddingEnd="0dp"
                        android:spinnerMode="dropdown"
                        android:overlapAnchor="false"
                        android:dropDownVerticalOffset="4dp"
                        android:dropDownHorizontalOffset="0dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_normal"
                    android:layout_marginBottom="20dp" />

                <!-- Mouse & Trackpad Group -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mouse_and_trackpad"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:letterSpacing="0.1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_toStartOf="@+id/tv_sensitivity_value"
                            android:text="@string/sensitivity"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tv_sensitivity_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="@string/sensitivity_default"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                    </RelativeLayout>

                    <SeekBar
                        android:id="@+id/seekbar_sensitivity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="50"
                        android:progress="30" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_normal"
                    android:layout_marginBottom="20dp" />

                <!-- Keyboard Group -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_keyboard"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:letterSpacing="0.1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_layout"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/layout_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/spinner_settings_layout"
                        android:layout_width="155dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/spinner_background"
                        android:paddingStart="8dp"
                        android:paddingEnd="0dp"
                        android:spinnerMode="dropdown"
                        android:overlapAnchor="false"
                        android:dropDownVerticalOffset="4dp"
                        android:dropDownHorizontalOffset="0dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_normal"
                    android:layout_marginBottom="20dp" />

                <!-- Bluetooth Visibility Group -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bluetooth_visibility"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:letterSpacing="0.1" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_settings_discoverable"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/make_discoverable"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_bluetooth"
                    android:drawableTint="#FFFFFF"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_primary"
                    app:backgroundTint="@null"
                    android:layout_marginBottom="24dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_normal"
                    android:layout_marginBottom="20dp" />

                <!-- About Group -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_about"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"
                    android:letterSpacing="0.1" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@+id/tv_version_value"
                        android:text="@string/label_version"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_version_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/version_value"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </RelativeLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_settings_help"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="@string/user_guide_and_reference"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/ic_help"
                    android:drawableTint="#FFFFFF"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/button_primary"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_alignParentBottom="true"
        android:background="@android:color/transparent"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginBottom="0dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:baselineAligned="false">
        <!-- Shortcuts Tab -->
        <LinearLayout
            android:id="@+id/nav_shortcuts"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/container_shortcuts_pill"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="2dp">
                <ImageView
                    android:id="@+id/iv_nav_shortcuts"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_shortcuts"
                    app:tint="@color/nav_selected_icon"
                    android:layout_gravity="center"
                    android:contentDescription="@string/tab_shortcuts" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_nav_shortcuts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_shortcuts"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Input Tab -->
        <LinearLayout
            android:id="@+id/nav_input"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/container_input_pill"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="2dp">
                <ImageView
                    android:id="@+id/iv_nav_input"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/mouse_24"
                    app:tint="@color/text_secondary"
                    android:layout_gravity="center"
                    android:contentDescription="@string/tab_input" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_nav_input"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_input"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Scripting Tab -->
        <LinearLayout
            android:id="@+id/nav_scripting"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/container_scripting_pill"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="2dp">
                <ImageView
                    android:id="@+id/iv_nav_scripting"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_scripting"
                    app:tint="@color/text_secondary"
                    android:layout_gravity="center"
                    android:contentDescription="@string/tab_scripting" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_nav_scripting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_scripting"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Settings Tab -->
        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:clickable="true"
            android:focusable="true">

            <FrameLayout
                android:id="@+id/container_settings_pill"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="2dp">
                <ImageView
                    android:id="@+id/iv_nav_settings"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/text_secondary"
                    android:layout_gravity="center"
                    android:contentDescription="@string/tab_settings" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_nav_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_settings"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>