<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#0F0F1A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shortcut Name"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/dialog_et_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="e.g. Open Command Prompt"
        android:textColor="#FFFFFF"
        android:textColorHint="#475569"
        android:background="@drawable/edit_text_background"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:inputType="text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shortcut Icon"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/dialog_sp_icon"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/edit_text_background"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ducky Script Payload"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/dialog_et_script"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:hint="GUI r`nDELAY 500`nSTRING cmd`nENTER"
        android:textColor="#FFFFFF"
        android:textColorHint="#475569"
        android:gravity="top|start"
        android:background="@drawable/edit_text_background"
        android:padding="16dp"
        android:inputType="textMultiLine"
        android:scrollbars="vertical"
        android:layout_marginBottom="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dialog_btn_pin"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="Pin to Home Screen"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_secondary"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/dialog_btn_delete"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="Delete"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_secondary" />
    </LinearLayout>

</LinearLayout>
