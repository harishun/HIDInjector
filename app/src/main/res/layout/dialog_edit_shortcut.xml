<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/dialog_card_background"
    tools:ignore="Overdraw">

    <!-- Header Row: Pin to Home (Top Left, Round), Title (Center), Close (Top Right) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/dialog_btn_pin"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/button_round_glass"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:src="@drawable/ic_home_plus"
            app:tint="#FFFFFF"
            android:contentDescription="@string/desc_add_to_home_screen"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/dialog_tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/dialog_btn_pin"
            android:layout_toStartOf="@id/dialog_btn_close"
            android:layout_marginHorizontal="8dp"
            android:gravity="center"
            android:text="@string/dialog_title_shortcut_details"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/dialog_btn_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_close"
            app:tint="@color/status_red"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:contentDescription="@string/desc_close_popup"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_shortcut_name"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/dialog_et_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="@string/hint_shortcut_name"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:background="@drawable/edit_text_background"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:importantForAutofill="no"
        android:inputType="text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_shortcut_icon"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <Spinner
        android:id="@+id/dialog_sp_icon"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/spinner_background"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="16dp"
        android:spinnerMode="dropdown"
        android:overlapAnchor="false"
        android:dropDownVerticalOffset="4dp"
        android:dropDownHorizontalOffset="0dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_ducky_script_payload"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/dialog_et_script"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:hint="@string/hint_ducky_script_default"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_hint"
        android:gravity="top|start"
        android:background="@drawable/edit_text_background"
        android:padding="16dp"
        android:inputType="textMultiLine"
        android:importantForAutofill="no"
        android:scrollbars="vertical"
        android:layout_marginBottom="20dp" />

    <!-- Bottom Action Row: Save Button (Bottom Left), Delete Button (Bottom Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/dialog_btn_save"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:background="@drawable/button_primary"
            android:layout_marginEnd="8dp"
            android:src="@drawable/save_24"
            app:tint="@color/status_green"
            android:padding="12dp"
            android:contentDescription="@string/desc_save"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/dialog_btn_delete"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:background="@drawable/button_primary"
            android:src="@drawable/ic_trash"
            app:tint="@color/status_red"
            android:padding="12dp"
            android:contentDescription="@string/desc_delete"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
